generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "BLR3396", "BLR3630"
  name           String    // e.g. "Metro Inn Rooms", "Super Hotel O Sahasra"
  logo           String?
  coverImage     String?
  address        String?
  city           String    @default("Bangalore")
  state          String    @default("Karnataka")
  country        String    @default("India")
  pincode        String?
  phone          String?
  email          String?
  website        String?
  currency       String    @default("INR")
  currencySymbol String    @default("₹")
  timezone       String    @default("Asia/Kolkata")
  taxRate        Float     @default(12.0)
  checkInTime    String    @default("12:00 PM")
  checkOutTime   String    @default("11:00 AM")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  categories     RoomCategory[]
  rooms          Room[]
  bookings       Booking[]
  guests         Guest[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("superadmin") // superadmin, admin, staff
  propertyId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  property     Property? @relation(fields: [propertyId], references: [id])
  payments     Payment[]
}

model RoomCategory {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  nightlyRate Float
  totalRooms  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms       Room[]

  @@unique([propertyId, name])
}

model Room {
  id           String        @id @default(cuid())
  propertyId   String
  number       String
  categoryId   String
  status       String        @default("Available") // Available, Occupied, Cleaning, Maintenance, Out of Service
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category     RoomCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookingRooms BookingRoom[]
  statusLogs   RoomStatusLog[]

  @@unique([propertyId, number])
}

model Guest {
  id         String    @id @default(cuid())
  propertyId String
  name       String
  phone      String
  email      String?
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

model Booking {
  id             String             @id @default(cuid())
  propertyId     String
  bookingRef     String             @unique
  guestId        String
  status         String             @default("Upcoming") // Upcoming, CheckedIn, CheckedOut, NoShow, Cancelled
  source         String
  checkIn        DateTime
  checkOut       DateTime
  numRooms       Int                @default(1)
  adults         Int                @default(1)
  kids           Int                @default(0)
  nightlyRate    Float
  taxAmount      Float              @default(0)
  discountAmount Float              @default(0)
  totalAmount    Float
  notes          String?
  roomCategory   String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  property       Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest          Guest              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  bookingRooms   BookingRoom[]
  payments       Payment[]
  invoices       Invoice[]
  statusLogs     BookingStatusLog[]
}

model BookingRoom {
  id        String   @id @default(cuid())
  bookingId String
  roomId    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  amount      Float
  mode        String
  status      String
  utrRef      String?
  collectedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [collectedBy], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  bookingId   String
  generatedAt DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RoomStatusLog {
  id        String   @id @default(cuid())
  roomId    String
  oldStatus String
  newStatus String
  changedBy String?
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model BookingStatusLog {
  id        String   @id @default(cuid())
  bookingId String
  oldStatus String
  newStatus String
  changedBy String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
