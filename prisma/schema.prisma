generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("staff")
  propertyId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
}

model RoomCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  nightlyRate Float
  totalRooms  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
}

model Room {
  id           String        @id @default(cuid())
  number       String        @unique
  categoryId   String
  status       String        @default("Available")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     RoomCategory  @relation(fields: [categoryId], references: [id])
  bookingRooms BookingRoom[]
  statusLogs   RoomStatusLog[]
}

model Guest {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id           String             @id @default(cuid())
  bookingRef   String             @unique
  guestId      String
  status       String             @default("Upcoming")
  source       String
  checkIn      DateTime
  checkOut     DateTime
  numRooms     Int                @default(1)
  adults       Int                @default(1)
  kids         Int                @default(0)
  nightlyRate  Float
  totalAmount  Float
  notes        String?
  roomCategory String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  guest        Guest              @relation(fields: [guestId], references: [id])
  bookingRooms BookingRoom[]
  payments     Payment[]
  invoices     Invoice[]
  statusLogs   BookingStatusLog[]
}

model BookingRoom {
  id        String   @id @default(cuid())
  bookingId String
  roomId    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String
  amount      Float
  mode        String
  status      String
  utrRef      String?
  collectedBy String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [collectedBy], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  bookingId   String
  generatedAt DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model RoomStatusLog {
  id        String   @id @default(cuid())
  roomId    String
  oldStatus String
  newStatus String
  changedBy String?
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model BookingStatusLog {
  id        String   @id @default(cuid())
  bookingId String
  oldStatus String
  newStatus String
  changedBy String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
